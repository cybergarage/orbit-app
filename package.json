{
  "name": "orbit-app",
  "version": "0.1.0",
  "private": true,
  "description": "Local Orbit desktop prototype",
  "author": "Cybergarage",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src test scripts worker --error-on-warnings",
    "test": "tsx --test test/*.test.ts worker/*.test.mjs",
    "test:ui": "npm run build && playwright test",
    "test:live": "tsx scripts/live.ts",
    "worker:build": "docker build -t orbit-app-worker:0.1.0 worker",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.7",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "tsx": {
      "esbuild": "0.28.2"
    }
  }
}
