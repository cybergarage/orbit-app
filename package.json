{
  "name": "orbit-app",
  "version": "0.1.0",
  "private": true,
  "description": "Local Orbit desktop prototype",
  "author": "Cybergarage",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src test scripts worker --error-on-warnings",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts worker/*.test.mjs",
    "test:electron-sqlite": "node scripts/electron-sqlite-smoke.mjs",
    "test:host-package": "npm run package -- --verify",
    "test:host-default": "npm run build -- --fresh-host-default && node scripts/electron-sqlite-smoke.mjs host-default-proof",
    "test:host-profile-transition": "npm run build && node scripts/electron-sqlite-smoke.mjs host-profile-transition",
    "test:host-file-changes": "npm run build && node scripts/electron-sqlite-smoke.mjs host-file-changes",
    "test:host-catalog": "npm run build && node scripts/electron-sqlite-smoke.mjs host-proof",
    "package:host-agent": "npm run build -- --fresh-host-default && node scripts/electron-sqlite-smoke.mjs host-package",
    "test:ui": "npm run build && playwright test",
    "test:live": "tsx scripts/live.ts",
    "metadata:recover": "tsx scripts/recover-metadata.ts",
    "worker:build": "docker build -t orbit-app-worker:project-memory-local worker",
    "worker:readiness:build": "docker build -t orbit-app-workspace-readiness:local worker/readiness",
    "worker:reader:build": "docker build -f worker/reader/Dockerfile -t orbit-app-workspace-reader:local worker",
    "worker:workspace:build": "docker build --network=none -t orbit-app-workspace:local worker/workspace",
    "package": "npm run build -- --fresh-host-default && node scripts/electron-sqlite-smoke.mjs default-package",
    "package:legacy": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@cybergarage/orbit": "0.9.4-next.3",
    "@js-temporal/polyfill": "0.5.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.7",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "tsx": {
      "esbuild": "0.28.2"
    }
  }
}
